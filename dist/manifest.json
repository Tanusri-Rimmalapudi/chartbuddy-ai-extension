{
  "manifest_version": 3,
  "name": "ChartBuddy",
  "version": "1.1.0",
  "description": "Draw a box around a chart and let Gemini analyze it.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "ChartBuddy"
  }
}
